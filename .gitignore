# ---- Node (from GitHub's Node.gitignore template) ----
node_modules/
jspm_packages/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
*.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
.nyc_output/
.cache/
.parcel-cache/
.vite/
.next/
out/
dist/
build/
logs/
*.log

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Chrome extension packaging ----
# Private signing key: never commit. Losing control of it lets someone else
# publish updates under your extension ID.
*.pem
*.crx
*.zip

# ---- Python (classifier training, if any) ----
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- Local databases ----
*.sqlite3
*.db

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
